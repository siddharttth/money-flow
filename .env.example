# Neon / Vercel Postgres connection string (pooled URL works fine)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: require this code to register. Leave empty to allow open signup.
SIGNUP_CODE=""
